# Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=HighTech RMA System

# Database
DATABASE_URL=postgresql://admin:admin123@localhost:5432/hightech_rma_dev

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO/Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET_NAME=development-rma-documents

# File Upload
MAX_FILE_SIZE_MB=2
ALLOWED_EXTENSIONS=.pdf
FILE_RETENTION_DAYS=60

# Payment Reminders (Recordatorios de Pago)
# Intervalo entre envío de recordatorios (en días)
PAYMENT_REMINDER_INTERVAL_DAYS=3
# Frecuencia de verificación del scheduler (en horas)
PAYMENT_REMINDER_CHECK_INTERVAL_HOURS=24

# CORS (para frontend futuro)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173