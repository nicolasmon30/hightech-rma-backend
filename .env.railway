# Este archivo es solo para que el build pase
# Las variables reales se configuran en Railway dashboard
PROJECT_NAME=HighTech RMA System
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
SECRET_KEY=temp-key-will-be-overridden-by-railway
ALGORITHM=HS256
